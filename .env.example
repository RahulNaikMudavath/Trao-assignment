# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Database
# If left blank or if MongoDB is not reachable, an in-memory/file storage engine is used automatically
MONGODB_URI=mongodb://localhost:27017/trao

# Authentication
JWT_SECRET=super-secret-jwt-key-trao-assessment-2026

# LLM Providers (Genuine Free Tier)
# Preferred: Google Gemini (Free tier with generous limits: Gemini 2.0 Flash / 1.5 Flash)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative Provider: Groq (Free tier with Llama 3.3 70B Versatile)
# Get a free key at: https://console.groq.com/
GROQ_API_KEY=

# Active LLM Provider: 'gemini', 'groq', or 'mock' (mock is used for deterministic offline tests)
LLM_PROVIDER=gemini

# Security / Crawler
# Set to 'true' to allow fetching localhost / 127.0.0.1 for Section 9 batch evaluation test suites
ALLOW_LOCAL_URLS=true
CRAWLER_TIMEOUT_MS=10000
MAX_PAGE_BYTES=2097152
